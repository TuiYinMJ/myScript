#!name = ixybz 去广告解锁VIP
#!desc = 依赖 GitHub Raw 远程脚本
#!author = TuiYinMJ
#!loon_version = 3.5.1(983)

[Script]
request if ${url} ~= /^https?:\/\/app\.ixybz\.com\// then script("https://raw.githubusercontent.com/TuiYinMJ/myScript/refs/heads/master/js/ixybz-request.js") with tag="ixybz请求", requires_body=false
response if ${url} ~= /^https?:\/\/app\.ixybz\.com\// then script("https://raw.githubusercontent.com/TuiYinMJ/myScript/refs/heads/master/js/ixybz-response.js") with tag="ixybz响应", requires_body=true, timeout=120

[MITM]
hostname = app.ixybz.com