#!name = Pingo AI 解锁 Pro 会员
#!desc = 三层解锁 Pingo（i.pingo.ai）Pro：请求侧直返 /user/entitlement 的 isPro=true、Superwall entitlements 的 pro active，并把 static_config 的付费墙触发器全部置为不匹配；绕开 304/缓存
#!author = TuiYinMJ
#!homepage = https://github.com/TuiYinMJ/myScript
#!icon = https://github.com/TuiYinMJ/myScript/blob/master/res/lingoDuo.png?raw=true
#!tag = 解锁会员, Pingo
#!openUrl = https://apps.apple.com/cn/app/id6738882620
#!loon_version = 3.5.1(983)

[Script]
# 两条链路共用一个 JS，由脚本按 URL 分派。
# URL 末尾 ?v=7 是缓存破坏参数：Loon 按 URL 缓存远程脚本，改完 JS 必须升版本号。
# 脚本走 gh-proxy 镜像：raw.githubusercontent.com 在国内常连不上，插件订阅也会因此显示成哈希。
request if ${url} ~= /^https:\/\/(?:i\.pingo\.ai\/user\/entitlement|subscriptions-api\.superwall\.com\/subscriptions-api\/public\/v1\/users\/[^\/]+\/entitlements|api\.superwall\.me\/api\/v1\/static_config)/i then script("https://gh-proxy.com/https://raw.githubusercontent.com/TuiYinMJ/myScript/master/js/pingo-request.js?v=7") with tag="Pingo直返", requires_body=false
response if ${url} ~= /^https:\/\/(?:i\.pingo\.ai\/user\/entitlement|subscriptions-api\.superwall\.com\/subscriptions-api\/public\/v1\/users\/[^\/]+\/entitlements|api\.superwall\.me\/api\/v1\/static_config)/i then script("https://gh-proxy.com/https://raw.githubusercontent.com/TuiYinMJ/myScript/master/js/pingo-vip.js?v=7") with tag="PingoPro", timeout=60, requires_body=true

[MITM]
hostname = subscriptions-api.superwall.com, i.pingo.ai, api.superwall.me
