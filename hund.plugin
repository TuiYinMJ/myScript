#!name = 混沌大学 会员改写（全接口）
#!desc = 覆盖用户信息 / 会员页 / 课程列表权限 / 课程详情 is_dhy / capi 升级配置 / 活动详情 / AI 助手会员状态；补齐 sku_list 全部模式，清理 gzip 与 Etag 并禁止缓存
#!author = Aether
#!homepage = https://github.com/TuiYinMJ/myScript
#!icon = https://github.com/TuiYinMJ/myScript/blob/master/res/hund.png?raw=true
#!loon_version = 3.5.1(983)
#!tag = 会员, 解锁

[Rewrite]
# user / capi / course / hundun-agent 的 JSON 响应都带 Etag；命中 304 时 Response Script 拿不到 body，改写会静默失效。
# 只针对 API 路径删条件请求头，避免让 tools.hundun.cn 上带 hash 的 1MB+ 静态 JS 每次都全量重下。
request if ${url} ~= /^https:\/\/(?:user|capi|course)\.hundun\.cn\/|^https:\/\/tools\.hundun\.cn\/h5Bin\/hundun-agent\/api\//i then request.header.del("If-None-Match") | request.header.del("If-Modified-Since")

[Script]
# Loon 983+ 的 Response Script 是 first-match：一个请求只执行一条，所以只留一条规则，由 hund.js 按 host+path 分派。
# 放宽到 user / capi / course 全域，覆盖点进课程详情页才出现的 /boutique/get_package_detail 等接口；
# 发现新接口后只需更新 JS，不必重新导入插件。
#
# URL 末尾的 ?v=3 是缓存破坏参数：Loon 按 URL 缓存远程脚本，改了 JS 但 URL 不变会一直跑旧代码。
# 每次改完 js/hund.js，把版本号 +1 并重载 Loon 配置。
#
# 若怀疑 raw 的 CDN 仍在回旧内容，可换成固定 commit 的不可变地址（本版对应 105ff17）：
#   https://raw.githubusercontent.com/TuiYinMJ/myScript/105ff17/js/hund.js
#
# 最稳妥的用法（不受 GitHub raw 连通性与远程缓存影响）：
#   把 js/hund.js 放进 Loon 脚本目录，改用同目录下的 hund-local.plugin（script("hund.js")）。
response if ${url} ~= /^https:\/\/(?:user|capi|course)\.hundun\.cn\/|^https:\/\/tools\.hundun\.cn\/h5Bin\/hundun-agent\/api\/auth\//i then script("https://raw.githubusercontent.com/TuiYinMJ/myScript/refs/heads/master/js/hund.js?v=3") with tag="混沌会员全接口", timeout=20, requires_body=true, debug=true

[MITM]
hostname = user.hundun.cn, capi.hundun.cn, course.hundun.cn, tools.hundun.cn
