[Script]
http-response ^https:\/\/user\.hundun\.cn\/get_user_info script-path=https://raw.githubusercontent.com/TuiYinMJ/myScript/refs/heads/master/js/hund.js, requires-body=true, timeout=15, tag=混沌VIP改写

[Mitm]
hostname = user.hundun.cn, course.hundun.cn, tools.hundun.cn