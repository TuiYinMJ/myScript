#!name = 混沌大学 会员改写（全接口）
#!desc = 覆盖 get_user_info / dhy 会员页 / capi 升级配置 / 活动详情 / AI 助手会员状态，并清理 gzip 与 Etag 响应头
#!author = Aether
#!homepage = https://github.com/TuiYinMJ/myScript
#!icon = https://github.com/TuiYinMJ/myScript/blob/master/res/hund.png?raw=true
#!loon_version = 3.5.1(983)
#!tag = 会员, 解锁

[Rewrite]
# user.hundun.cn 的 JSON 响应带 Etag，命中 304 时脚本拿不到 body
request if ${url} ~= /^https:\/\/user\.hundun\.cn\//i then request.header.del("If-None-Match")

[Script]
# Loon 983+ 的 Response Script 是 first-match：一个请求只会执行一条，写多条只有第一条生效。
# 因此这里只用一条规则，由 hund.js 按 host+path 精确分派；以后新增接口只改远程 JS，不用重新导入插件。
response if ${url} ~= /^https:\/\/(?:user|capi|course|tools)\.hundun\.cn\/(?:get_user_info|dhy\/|activity\/|online\/|h5Bin\/hundun-agent\/api\/auth\/)/i then script("https://raw.githubusercontent.com/TuiYinMJ/myScript/refs/heads/master/js/hund.js") with tag="混沌会员全接口", timeout=20, requires_body=true, debug=true

[MITM]
hostname = user.hundun.cn, capi.hundun.cn, course.hundun.cn, tools.hundun.cn
