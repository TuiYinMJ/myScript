#!name = 边界猎手 SVIP 解锁
#!desc = 解锁边界猎手（BH pro）SVIP：会员状态与到期时间、商圈查询/地图搜索次数、权益次数、报告定价；同时去除开屏、信息流、悬浮窗、问卷及付费弹窗广告
#!author = TuiYinMJ
#!homepage = https://github.com/TuiYinMJ/myScript
#!icon = https://github.com/TuiYinMJ/myScript/blob/master/res/bjls.png?raw=true
#!tag = 去广告, 解锁会员
#!openUrl = https://apps.apple.com/cn/app/id1641843287
#!loon_version = 3.5.1(983)

[Script]
response if ${url} ~= /^https:\/\/litebhapi\.belugabh\.com\/+(center-bh-pro-biz-core\/svip\/(getUserVipMessage|getSVipPicture|personalCenterMy)|personal_center\/user_equity_status_list|center-bh-pro-biz-core\/map\/bh\/dsqRangeNum|center-bh-pro-poi-core\/data\/dataMapSearchNum|center-bh-pro-biz-core\/ad\/(selectData|sdKqhx)|center-bh-pro-manage-core\/ads\/getAvailableQuestionnaire|center-bh-pro-biz-core\/activity\/(selectPopNewPeopleList|indexActivity)|center-bh-pro-user-core\/dataUpdateRecord\/todayPageNotice|center-bh-pro-manage-core\/goldenEntry\/appList|center-bh-pro-biz-core\/wallet\/getPortraitGoodsByUserLevel)/i then script("https://raw.githubusercontent.com/TuiYinMJ/myScript/refs/heads/master/js/beluga-svip.js") with tag="边界SVIP", timeout=60, requires_body=true

[MITM]
hostname = litebhapi.belugabh.com
