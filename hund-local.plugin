#!name = 混沌大学 会员改写（本地脚本版）
#!desc = 与 hund.plugin 逻辑完全一致，但脚本从 Loon 本地目录读取，不依赖 GitHub raw，也不受远程缓存影响。使用前把 js/hund.js 放进 Loon 的脚本目录（文件名保持 hund.js）
#!author = Aether
#!homepage = https://github.com/TuiYinMJ/myScript
#!icon = https://github.com/TuiYinMJ/myScript/blob/master/res/hund.png?raw=true
#!loon_version = 3.5.1(983)
#!tag = 会员, 解锁

[Rewrite]
request if ${url} ~= /^https:\/\/(?:user|capi|course)\.hundun\.cn\/|^https:\/\/tools\.hundun\.cn\/h5Bin\/hundun-agent\/api\//i then request.header.del("If-None-Match") | request.header.del("If-Modified-Since")

[Script]
# 本地版：改完 js/hund.js 只需在 Loon 里重载配置，不需要 push、不需要改 URL 版本号。
# 注意：请与 hund.plugin 二选一启用，同时开会出现两条 Response Script（first-match 只跑第一条）。
response if ${url} ~= /^https:\/\/(?:user|capi|course)\.hundun\.cn\/|^https:\/\/tools\.hundun\.cn\/h5Bin\/hundun-agent\/api\/auth\//i then script("hund.js") with tag="混沌会员全接口(本地)", timeout=20, requires_body=true, debug=true

[MITM]
hostname = user.hundun.cn, capi.hundun.cn, course.hundun.cn, tools.hundun.cn
