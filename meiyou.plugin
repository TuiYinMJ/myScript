[Script]
response if ${url} ~= /^https?:\/\/(?:ad|mgo|sub|tequan|users)\.seeyouyima\.com\//i then script("https://raw.githubusercontent.com/TuiYinMJ/myScript/refs/heads/master/js/meiyou.js") with tag="美柚去广告/VIP", requires_body=true, timeout=60

[MITM]
hostname = *.seeyouyima.com
